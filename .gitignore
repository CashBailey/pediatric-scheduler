# Dependencies
node_modules/

# Python backend virtualenv + caches (backend_py/.venv is the Python
# equivalent of node_modules; never committed, excluded from the
# offline-contract scan for the same reason).
backend_py/.venv/
__pycache__/
*.pyc
.pytest_cache/

# Claude Code local state (transient agent workspaces, scheduled-task locks,
# etc. — machine-local, never source).
.claude/

# Playwright MCP artifacts (screenshots / accessibility snapshots produced
# during agent-driven browser sessions; not source).
.playwright-mcp/

# graphify skill output (knowledge-graph HTML/JSON + cache; analysis
# artifacts, not source).
graphify-out/

# GUI-review screenshots / snapshots (transient before/after artifacts from
# browser verification; not source).
gui-review/
app-open-*.png
planning-grid-snapshot.md

# CLI-first verification evidence generated by make verify-project.
verification/results/

# Build output
dist/
.build/
.swiftpm/

# Customer release bundles (large prebuilt Docker images + their distribution zips)
release/**/*.tar.gz
release/*.zip

# Editor / OS
.DS_Store
.vscode/
.idea/
*.swp

# Logs
npm-debug.log*
*.log
